# CapiscIO Enforcement Demo
# Copy to .env and add your API key.
#   https://app.capisc.io → Settings → API Keys

# ── Required ─────────────────────────────────────────────────────────────
CAPISCIO_API_KEY=sk_live_EXAMPLE_REPLACE_ME

# ── Defaults (override only if needed) ───────────────────────────────────

# MCP server identity: "auto" registers a new server on first run
# (persists in ~/.capiscio/). To reuse an existing server, paste its UUID.
CAPISCIO_SERVER_ID=auto

# Registry URL — only change for self-hosted or staging environments.
# CAPISCIO_SERVER_URL=https://registry.capisc.io
